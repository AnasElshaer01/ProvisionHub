# ProvisionHub — runtime configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Database connection (SQLite by default, or swap to Postgres)
# DATABASE_URL=sqlite+aiosqlite:///./provisionhub.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/provisionhub

# Bearer token that Entra ID or your SCIM client sends on inbound requests
SCIM_BEARER_TOKEN=dev-token

# Jira Cloud credentials
# Get your API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=admin@yourorg.com
JIRA_API_TOKEN=<your-api-token-here>

# Slack connector (future)
# SLACK_TOKEN=xoxb-...

# Zendesk connector — API token auth
# Generate token at: Admin → Apps & Integrations → API Tokens → Add API Token
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=


